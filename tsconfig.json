{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "App.tsx",
    "index.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".expo",
    ".env",
    "tests",
    "scripts"
  ]
}
